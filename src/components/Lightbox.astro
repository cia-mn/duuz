---
/**
 * Full-screen viewer on a native <dialog>: a scroll-snap strip gives swipe on
 * touch, the buttons / arrow keys cover desktop. No lightbox library.
 *
 * Anything with data-lightbox="<id>" data-index="<n>" opens it at slide n; make
 * the opener an <a> to the slide's file (see fullSize) so it works without JS.
 * A work with a `video` plays it here with controls, its photo as the poster.
 */
import { Icon } from "astro-icon/components";
import type { Work } from "../content";
import { fullSize } from "./fullSize";

interface Props {
	items: Work[];
	id: string;
	label?: string;
}

const { items, id, label = "Зургийн үзүүлэлт" } = Astro.props;
const full = await Promise.all(items.map((w) => fullSize(w.image)));
const many = items.length > 1;
---

<dialog id={id} class="lightbox" aria-label={label}>
	<button type="button" class="lb-btn close" aria-label="Хаах" data-close>
		<Icon name="material-symbols:close-rounded" class="size-7" />
	</button>
	{
		many && (
			<button type="button" class="lb-btn prev" aria-label="Өмнөх" data-dir="-1">
				<Icon name="material-symbols:chevron-left-rounded" class="size-9" />
			</button>
		)
	}
	{
		many && (
			<button type="button" class="lb-btn next" aria-label="Дараах" data-dir="1">
				<Icon name="material-symbols:chevron-right-rounded" class="size-9" />
			</button>
		)
	}
	<div class="strip">
		{
			items.map((w, i) => (
				<figure>
					{w.video ? (
						<video
							src={w.video}
							poster={full[i].src}
							width={w.image.width}
							height={w.image.height}
							muted
							loop
							playsinline
							controls
							preload="none"
							aria-label={w.title}
						/>
					) : (
						<img src={full[i].src} alt={w.title} loading="lazy" decoding="async" class="photo" data-reveal="fade" />
					)}
					<figcaption>
						{w.title}
						{many && " "}
						{many && <span class="count">{`${i + 1} / ${items.length}`}</span>}
					</figcaption>
				</figure>
			))
		}
	</div>
</dialog>

<style>
	.lightbox {
		position: fixed;
		inset: 0;
		width: 100vw;
		height: 100vh;
		max-width: none;
		max-height: none;
		margin: 0;
		padding: 0;
		border: 0;
		background: transparent;
		color: oklch(95% 0.008 85);
	}
	.lightbox::backdrop {
		background: oklch(10% 0.004 60 / 0.96);
	}
	.strip {
		display: flex;
		height: 100%;
		overflow-x: auto;
		overflow-y: hidden;
		scroll-snap-type: x mandatory;
		scrollbar-width: none;
	}
	.strip::-webkit-scrollbar {
		display: none;
	}
	.strip figure {
		display: flex;
		flex: 0 0 100%;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.75rem;
		height: 100%;
		padding: 4rem 1rem 2.5rem;
		scroll-snap-align: center;
	}
	.strip img,
	.strip video {
		flex: 0 1 auto;
		min-height: 0;
		width: auto;
		height: auto;
		max-width: 100%;
		max-height: 100%;
		object-fit: contain;
		border-radius: 0.5rem;
	}
	.strip figcaption {
		font-size: 0.75rem;
		letter-spacing: 0.12em;
		text-align: center;
		text-transform: uppercase;
		color: oklch(80% 0.085 85); /* champagne — the overlay is dark in both themes */
	}
	.count {
		margin-left: 0.75em;
		color: oklch(80% 0.012 75);
		font-variant-numeric: tabular-nums;
	}
	.lb-btn {
		position: absolute;
		z-index: 1;
		display: grid;
		place-items: center;
		width: 3rem;
		height: 3rem;
		border-radius: 9999px;
		background: oklch(100% 0 0 / 0.12);
		color: white;
		backdrop-filter: blur(6px);
		transition: background-color 150ms var(--ease-standard);
	}
	.lb-btn:hover {
		background: oklch(100% 0 0 / 0.24);
	}
	.lb-btn:focus-visible {
		outline: 2px solid var(--color-focus);
		outline-offset: 2px;
	}
	.close {
		top: 1rem;
		right: 1rem;
	}
	.prev,
	.next {
		top: 50%;
		transform: translateY(-50%);
	}
	.prev {
		left: 1rem;
	}
	.next {
		right: 1rem;
	}
	@media (hover: none) {
		.prev,
		.next {
			display: none; /* touch: swipe the strip instead */
		}
	}
</style>

<script>
	document.querySelectorAll<HTMLDialogElement>("dialog.lightbox").forEach((dialog) => {
		const strip = dialog.querySelector<HTMLElement>(".strip");
		if (!strip) return;

		const go = (i: number) => strip.scrollTo({ left: i * strip.clientWidth, behavior: "instant" });
		const step = (dir: number) => strip.scrollBy({ left: dir * strip.clientWidth, behavior: "smooth" });

		document.querySelectorAll<HTMLElement>(`[data-lightbox="${dialog.id}"]`).forEach((opener) =>
			opener.addEventListener("click", (e) => {
				e.preventDefault();
				dialog.showModal();
				go(Number(opener.dataset.index));
			}),
		);
		dialog.querySelectorAll<HTMLButtonElement>("[data-dir]").forEach((b) =>
			b.addEventListener("click", () => step(Number(b.dataset.dir))),
		);
		dialog.querySelector("[data-close]")?.addEventListener("click", () => dialog.close());
		// Clicking the dark area (strip / figure padding) closes; clicking the image does not.
		dialog.addEventListener("click", (e) => {
			const t = e.target as HTMLElement;
			if (t === strip || t.tagName === "FIGURE") dialog.close();
		});
		dialog.addEventListener("keydown", (e) => {
			if ((e.target as HTMLElement).tagName === "VIDEO") return; // arrows seek the clip there
			if (e.key === "ArrowRight") step(1);
			if (e.key === "ArrowLeft") step(-1);
		});

		// Clips play only while their slide is snapped into place, which also stops them on close.
		const videos = strip.querySelectorAll("video");
		if (!videos.length) return;
		const io = new IntersectionObserver(
			(entries) => {
				for (const e of entries) {
					const v = e.target as HTMLVideoElement;
					if (e.isIntersecting) v.play().catch(() => {});
					else v.pause();
				}
			},
			{ root: strip, threshold: 0.6 },
		);
		videos.forEach((v) => io.observe(v));
	});
</script>
