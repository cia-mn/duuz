---
/**
 * The jobs, newest first, as an index: one row each (date, title, sector) that
 * opens in place on its photos and notes. Native <details name> makes it an
 * accordion — opening one closes the rest — so it needs no script, and the
 * photos of a closed job don't load.
 */
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import type { Sector, TimelineItem, Work } from "../content";
import Lightbox from "./Lightbox.astro";
import { fullSize } from "./fullSize";
import { preview } from "./preview";

interface Props {
	items: TimelineItem[];
	sectors: Sector[];
	id?: string;
	/** The gallery: a job photo that is also a tile opens with its caption and clip. */
	works?: Work[];
}

const { items, sectors, id = "jobs", works = [] } = Astro.props;
const bySector = new Map(sectors.map((s) => [s.key, s.label]));

// Each job's photos open in a lightbox of their own, so a job reads as one set.
const byImage = new Map(works.map((w) => [w.image, w]));
const sets = await Promise.all(
	items.map(async (item, i) => {
		const media = (item.images ?? []).map((image) => byImage.get(image) ?? { image, title: item.title });
		const full = await Promise.all(media.map((m) => fullSize(m.image)));
		const previews = await Promise.all(media.map((m) => preview(m.image)));
		return { media, previews, hrefs: media.map((m, n) => m.video ?? full[n].src), lightbox: `${id}-${i}-lightbox` };
	}),
);
---

<div class="jobs">
	<p class="head"><span>Төслүүд, он сар дарааллаар</span><span>{items.length} ажил</span></p>
	{
		items.map((item, i) => {
			const set = sets[i];
			return (
				<div class="job">
					<details name={id} open={i === 0}>
						<summary>
							<time class="date">{item.date}</time>
							<h3 class="title">{item.title}</h3>
							{(item.subtitle || item.location) && (
								<span class="sub">{[item.subtitle, item.location].filter(Boolean).join(" · ")}</span>
							)}
							<span class="sector">{bySector.get(item.sector)}</span>
							<Icon name="material-symbols:add-rounded" class="toggle size-6" aria-hidden="true" />
						</summary>

						<div class="body">
							{set.media.length > 0 && (
								<div class="shots">
									{set.media.map(({ image: img, video }, n) => (
										<a
											href={set.hrefs[n]}
											class="shot preview"
											style={`--preview: ${set.previews[n]}`}
											data-lightbox={set.lightbox}
											data-index={n}
										>
											<Image
												src={img}
												widths={[...[240, 480, 720].filter((w) => w < img.width), Math.min(img.width, 960)]}
												sizes="(max-width: 640px) 45vw, 15rem"
												alt={`${item.title} — ${n + 1}`}
												loading="lazy"
												class="photo"
												data-reveal="fade"
											/>
											{video && (
												<span class="play">
													<Icon name="material-symbols:play-arrow-rounded" class="size-4" aria-hidden="true" />
												</span>
											)}
										</a>
									))}
								</div>
							)}

							<div class="notes">
								<div>
									{item.description && <p class="desc">{item.description}</p>}
									{item.highlights && item.highlights.length > 0 && (
										<ul class="highlights">{item.highlights.map((h) => <li>{h}</li>)}</ul>
									)}
								</div>
								<div>
									{item.tags && item.tags.length > 0 && (
										<ul class="tags" aria-label="Материал">{item.tags.map((t) => <li>{t}</li>)}</ul>
									)}
									{item.links && item.links.length > 0 && (
										<div class="links">
											{item.links.map((l) => (
												<a href={l.url} target="_blank" rel="noopener noreferrer" class="link">
													<Icon name={l.icon ?? "material-symbols:open-in-new-rounded"} class="size-4" aria-hidden="true" />
													{l.label}
												</a>
											))}
										</div>
									)}
								</div>
							</div>
						</div>
					</details>
					{/* Outside <details>: a modal opened from a collapsing subtree is asking for trouble. */}
					{set.media.length > 0 && <Lightbox items={set.media} id={set.lightbox} label={item.title} />}
				</div>
			);
		})
	}
</div>

<style>
	.head {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		padding-bottom: 0.875rem;
		font-size: 0.7rem;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--color-muted);
	}
	.job {
		border-top: 1px solid var(--color-rule);
	}
	.job:last-child {
		border-bottom: 1px solid var(--color-rule);
	}

	/* === the row === */
	/* <summary> takes phrasing content and one heading, no wrappers, so the grid
	   places each piece by name. */
	summary {
		display: grid;
		grid-template-columns: 5.5rem 1fr 13rem 1.5rem;
		grid-template-areas:
			"date title sector toggle"
			". sub . toggle";
		align-items: baseline;
		gap: 0.375rem 1.5rem;
		padding: 1.5rem 0;
		cursor: pointer;
		list-style: none;
	}
	summary::-webkit-details-marker {
		display: none;
	}
	summary:focus-visible {
		outline: 2px solid var(--color-focus);
		outline-offset: 4px;
		border-radius: 0.25rem;
	}
	.date,
	.sector {
		font-size: 0.7rem;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--color-muted);
		font-variant-numeric: tabular-nums;
	}
	.date {
		grid-area: date;
	}
	.sector {
		grid-area: sector;
	}
	.title {
		grid-area: title;
		min-width: 0;
		font-family: var(--font-display);
		font-size: clamp(1.5rem, 1.2rem + 1vw, 2rem);
		font-weight: 300;
		line-height: 1.1;
		overflow-wrap: anywhere;
		transition: color 200ms var(--ease-standard);
	}
	.sub {
		grid-area: sub;
		font-size: 0.8125rem;
		color: var(--color-muted);
	}
	.toggle {
		grid-area: toggle;
		align-self: center;
		color: var(--color-muted);
		transition:
			transform 300ms var(--ease-emphasized),
			color 200ms var(--ease-standard);
	}
	summary:hover .title,
	summary:hover .toggle,
	details[open] .toggle {
		color: var(--color-accent);
	}
	details[open] .toggle {
		transform: rotate(45deg);
	}
	@media (max-width: 767px) {
		/* Date and sector share a line above the title; the + keeps its column. */
		summary {
			grid-template-columns: auto 1fr 1.5rem;
			grid-template-areas:
				"date sector toggle"
				"title title toggle"
				"sub sub toggle";
			gap: 0.5rem 1rem;
			padding: 1.25rem 0;
		}
	}

	/* === the open job === */
	.body {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
		padding: 0 0 2rem 7rem;
	}
	@media (max-width: 767px) {
		.body {
			padding-left: 0;
		}
	}
	@media (prefers-reduced-motion: no-preference) {
		details[open] .body {
			animation: open 400ms var(--ease-emphasized);
		}
	}
	@keyframes open {
		from {
			opacity: 0;
			transform: translateY(-0.5rem);
		}
	}
	.notes {
		display: grid;
		gap: 1.25rem 2.5rem;
	}
	@media (min-width: 768px) {
		.notes {
			grid-template-columns: 3fr 2fr;
		}
	}
	.desc {
		margin-bottom: 0.875rem;
		line-height: 1.65;
		color: var(--color-muted);
	}
	.highlights {
		display: flex;
		flex-direction: column;
		gap: 0.375rem;
	}
	.highlights li {
		position: relative;
		padding-left: 1.125rem;
		font-size: 0.875rem;
		line-height: 1.5;
		color: var(--color-muted);
	}
	.highlights li::before {
		content: "";
		position: absolute;
		top: 0.55rem;
		left: 0.25rem;
		width: 5px;
		height: 5px;
		border-radius: 9999px;
		background: var(--color-accent);
	}

	/* === project photos === */
	.shots {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(7rem, 1fr));
		gap: 0.5rem;
	}
	.shot {
		position: relative;
		overflow: hidden;
		border: 1px solid var(--color-rule);
		border-radius: 0.75rem;
		cursor: zoom-in;
		transition: border-color 150ms var(--ease-standard);
	}
	.shot:hover {
		border-color: var(--color-accent);
	}
	.shot:focus-visible {
		outline: 2px solid var(--color-focus);
		outline-offset: 2px;
	}
	/* Same badge as the gallery's clip tiles: this photo opens as a clip. */
	.play {
		position: absolute;
		top: 0.375rem;
		right: 0.375rem;
		display: grid;
		place-items: center;
		width: 1.75rem;
		height: 1.75rem;
		border-radius: 9999px;
		background: oklch(0% 0 0 / 0.45);
		color: white;
		backdrop-filter: blur(4px);
	}
	/* A lone photo is a plate, not a billboard. */
	.shot:only-child {
		max-width: 15rem;
	}
	.shot :global(img) {
		display: block;
		width: 100%;
		aspect-ratio: 2 / 3;
		/* Wide rows would turn two portrait shots into billboards — cap the
		   height and let cover crop the ratio back. */
		max-height: 22rem;
		object-fit: cover;
		transition: transform 700ms var(--ease-emphasized);
	}
	.shot:hover :global(img) {
		transform: scale(1.04);
	}
	@media (max-width: 639px) {
		.shot :global(img) {
			max-height: 14rem;
		}
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.375rem;
		margin-bottom: 1rem;
	}
	.tags li {
		padding: 0.25rem 0.625rem;
		border: 1px solid var(--color-rule);
		border-radius: 9999px;
		font-size: 0.6875rem;
		color: var(--color-muted);
	}
	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.875rem;
	}
	.link {
		display: inline-flex;
		align-items: center;
		gap: 0.375rem;
		font-size: 0.8125rem;
		color: var(--color-accent);
	}
	.link:hover {
		text-decoration: underline;
	}
</style>
