---
/**
 * What search engines read about the studio beyond the page text (schema.org
 * JSON-LD, in Google's rich results and knowledge panel): the business with its
 * phone, email, city, services and profiles, and the site itself. Only facts the page
 * already states — no address or opening hours the studio hasn't published.
 */
import { sectors, site } from "../content";

const url = (path: string) => new URL(path, Astro.site ?? Astro.url).href;
const business = url("/#business");
const data = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "FurnitureStore",
			"@id": business,
			name: site.name,
			description: site.description,
			url: url("/"),
			logo: url("/apple-touch-icon.png"),
			image: url("/og.jpg"),
			telephone: site.phoneHref.replace("tel:", ""),
			email: site.email,
			address: { "@type": "PostalAddress", addressLocality: site.city, addressCountry: "MN" },
			areaServed: { "@type": "City", name: site.city },
			founder: { "@type": "Person", name: site.owner },
			sameAs: [site.instagram, site.facebook],
			makesOffer: [...new Set(sectors.flatMap((s) => s.includes))].map((name) => ({
				"@type": "Offer",
				itemOffered: { "@type": "Service", name },
			})),
		},
		{
			"@type": "WebSite",
			"@id": url("/#website"),
			url: url("/"),
			name: site.name,
			inLanguage: "mn",
			publisher: { "@id": business },
		},
	],
};
// `<` escaped, so no string in the data can close the script element.
const json = JSON.stringify(data).replace(/</g, "\\u003c");
---

<script type="application/ld+json" set:html={json} />
