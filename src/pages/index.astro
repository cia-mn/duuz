---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import logo from "../assets/logo.jpg";
import Gallery from "../components/Gallery.astro";
import Hero from "../components/Hero.astro";
import ModelStage from "../components/ModelStage.astro";
import Timeline from "../components/Timeline.astro";
import Layout from "../layouts/Layout.astro";
import { categories, showcase, site, steps, timeline, works } from "../content";

const btn =
	"inline-flex items-center justify-center gap-2.5 rounded-full px-7 py-3.5 text-xs font-medium tracking-[0.16em] uppercase transition duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-focus focus-visible:ring-offset-2 focus-visible:ring-offset-paper md:text-[0.8rem]";
const btnPrimary = `${btn} glow bg-accent text-on-accent hover:brightness-110`;
const btnQuiet = `${btn} border border-rule text-ink hover:border-accent hover:text-accent`;
---

<Layout>
	<!-- Hero: the studio's work as a film still behind the logo mark; the calls to action slot in. -->
	<Hero>
		<a href={site.phoneHref} class={btnPrimary}>
			<Icon name="material-symbols:call" class="size-5" aria-hidden="true" />
			{site.phone}
		</a>
		<a href={site.instagram} target="_blank" rel="me noopener" class={btnQuiet}>
			<Icon name="fa6-brands:instagram" class="size-5" aria-hidden="true" />
			Instagram
		</a>
		<a href={site.facebook} target="_blank" rel="me noopener" class={btnQuiet}>
			<Icon name="fa6-brands:facebook" class="size-5" aria-hidden="true" />
			Facebook
		</a>
	</Hero>

	<Gallery items={works} />

	<!-- Services: what you can order, then the four steps that are ours, played out on a 3D model. -->
	<section id="services" class="mx-auto mt-24 max-w-screen-xl px-4 md:mt-32 md:px-8">
		<p class="eyebrow mb-4 text-center">Үйлчилгээ</p>
		<h2 class="font-display mb-4 text-center text-4xl md:text-5xl">Та зөвхөн захиална.</h2>
		<p class="mx-auto mb-8 max-w-screen-sm text-center text-muted">{site.servicesIntro}</p>

		<ul class="mb-10 flex flex-wrap justify-center gap-x-7 gap-y-3 text-[0.7rem] tracking-[0.16em] text-muted uppercase md:mb-12" aria-label="Юу захиалж болох вэ">
			{
				categories.map((c) => (
					<li class="inline-flex items-center gap-2">
						<Icon name={c.icon} class="size-5 text-accent" aria-hidden="true" />
						{c.label}
					</li>
				))
			}
		</ul>

		<ModelStage steps={steps} showcase={showcase} />
	</section>

	<div class="mt-24 md:mt-32">
		<Timeline items={timeline} categories={categories} works={works} title="Хийсэн ажлууд" subtitle={site.timelineIntro} />
	</div>

	<!-- Contact: the reference About panel (rounded paper-2 card, text + round portrait). -->
	<section id="contact" class="mx-auto mt-24 max-w-screen-lg px-4 md:mt-32 md:px-8">
		<div class="rounded-2xl border border-rule bg-paper-2 px-5 py-10 sm:px-10 md:py-14">
			<div class="grid items-center gap-8 sm:grid-cols-[1fr_auto]">
				<div>
					<p class="eyebrow mb-4">Холбоо барих</p>
					<h2 class="font-display mb-4 text-4xl md:text-5xl">{site.owner}</h2>
					<p class="mb-6 max-w-prose text-muted md:text-lg">{site.about}</p>
					<ul class="mb-8 space-y-2 text-sm md:text-base">
						<li class="flex items-center gap-2">
							<Icon name="material-symbols:call" class="size-5 text-accent" aria-hidden="true" />
							<a href={site.phoneHref} class="hover:text-accent">{site.phone}</a>
						</li>
						<li class="flex items-center gap-2">
							<Icon name="fa6-brands:instagram" class="size-5 text-accent" aria-hidden="true" />
							<a href={site.instagram} target="_blank" rel="me noopener" class="hover:text-accent">@duuz_design</a>
						</li>
						<li class="flex items-center gap-2">
							<Icon name="fa6-brands:facebook" class="size-5 text-accent" aria-hidden="true" />
							<a href={site.facebook} target="_blank" rel="me noopener" class="hover:text-accent">duuzdesigntavilga</a>
						</li>
						<li class="flex items-center gap-2">
							<Icon name="material-symbols:location-on-outline-rounded" class="size-5 text-accent" aria-hidden="true" />
							<span>{site.city}</span>
						</li>
					</ul>
					<div class="flex flex-wrap gap-3">
						<a href={site.phoneHref} class={btnPrimary}>Залгах</a>
						<a href={site.instagram} target="_blank" rel="me noopener" class={btnQuiet}>Instagram-аар бичих</a>
						<a href={site.facebook} target="_blank" rel="me noopener" class={btnQuiet}>Facebook-ээр бичих</a>
					</div>
				</div>
				<Image
					src={logo}
					width={150}
					height={150}
					alt={`${site.name} лого`}
					class="mx-auto size-36 rounded-2xl border border-rule object-contain dark:invert"
				/>
			</div>
		</div>
	</section>
</Layout>
