---
import { Icon } from "astro-icon/components";
import StructuredData from "../components/StructuredData.astro";
import { CARD } from "../components/social";
import { site } from "../content";
import "../styles/fonts.css";
import "../styles/global.css";

interface Props {
	title?: string;
	description?: string;
	/** Keep this page out of search results (the 404). */
	noindex?: boolean;
}

const { title = site.title, description = site.description, noindex = false } = Astro.props;
// Crawlers want absolute URLs on the host that answers without a redirect (`site`).
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const card = Astro.site ? new URL("/og.jpg", Astro.site).href : "/og.jpg";
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="mn">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="author" content={site.owner} />
		{noindex && <meta name="robots" content="noindex" />}
		{canonical && !noindex && <link rel="canonical" href={canonical} />}
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<!-- Link previews. The card is drawn at build time from the hero (src/components/social.ts). -->
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={site.name} />
		<meta property="og:locale" content="mn_MN" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		{canonical && <meta property="og:url" content={canonical} />}
		<meta property="og:image" content={card} />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:image:width" content={String(CARD.width)} />
		<meta property="og:image:height" content={String(CARD.height)} />
		<meta property="og:image:alt" content={`${site.name} — ${site.eyebrow}`} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:image" content={card} />
		{!noindex && <StructuredData />}
		<script is:inline>
			// Theme init before first paint. Dark is the brand default — the OS
			// preference does not get a vote, only an explicit toggle does.
			(function () {
				document.documentElement.classList.toggle("dark", localStorage.getItem("theme") !== "light");
			})();
			// Photos marked `data-reveal` get `data-loaded` once their file is in, and
			// CSS fades them in over their preview. `load` doesn't bubble, but caught
			// on the way down from here — before any <img> exists — none is missed.
			document.addEventListener(
				"load",
				function (e) {
					var img = e.target;
					if (img instanceof HTMLImageElement && img.hasAttribute("data-reveal")) img.setAttribute("data-loaded", "");
				},
				true,
			);
		</script>
	</head>
	<body class="flex min-h-screen flex-col">
		<header class="sticky top-0 z-40 border-b border-rule/60 bg-paper/75 backdrop-blur-md">
			<div class="mx-auto flex w-full max-w-screen-xl items-center justify-between gap-4 px-4 py-4 md:px-8">
				<a href="/#top" class="font-display text-2xl tracking-[0.06em]">{site.name}</a>
				<div class="flex items-center gap-4 sm:gap-6">
					<nav class="flex flex-wrap gap-x-5 gap-y-1 text-[0.7rem] tracking-[0.18em] text-muted uppercase max-sm:hidden">
						{site.nav.map((item) => <a href={item.href} class="transition-colors hover:text-accent">{item.label}</a>)}
					</nav>
					<a
						href={site.phoneHref}
						class="text-[0.7rem] tracking-[0.18em] text-accent uppercase sm:hidden"
						aria-label={`Залгах ${site.phone}`}
					>
						{site.phone}
					</a>
					<button
						id="theme-toggle"
						type="button"
						aria-label="Гэрэлтэй / харанхуй горим"
						class="flex size-10 shrink-0 items-center justify-center rounded-full border border-rule text-muted transition-colors duration-200 hover:border-accent hover:text-accent"
					>
						<Icon name="material-symbols:light-mode-rounded" class="hidden size-5 dark:block" />
						<Icon name="material-symbols:dark-mode-rounded" class="block size-5 dark:hidden" />
					</button>
				</div>
			</div>
		</header>

		<main class="flex-1"><slot /></main>

		<footer class="mx-auto mt-24 w-full max-w-screen-xl border-t border-rule/60 px-4 pt-10 pb-10 md:mt-32 md:px-8">
			<p class="font-display mb-2 text-center text-2xl tracking-[0.06em]">{site.name}</p>
			<p class="mb-5 text-center text-xs text-muted">
				<span lang="en">{site.english}</span><br /><span lang="mn-Latn">{site.latin}</span>
			</p>
			<nav class="mb-5 flex flex-wrap justify-center gap-x-5 gap-y-2 text-[0.7rem] tracking-[0.18em] uppercase">
				{site.nav.map((item) => <a href={item.href} class="text-muted transition-colors hover:text-accent">{item.label}</a>)}
				<a href={site.instagram} target="_blank" rel="me noopener" class="text-muted transition-colors hover:text-accent">Instagram</a>
				<a href={site.facebook} target="_blank" rel="me noopener" class="text-muted transition-colors hover:text-accent">Facebook</a>
			</nav>
			<p class="text-center text-xs text-muted">© {year} {site.name} · {site.city} · {site.phone}</p>
		</footer>

		<script>
			document.getElementById("theme-toggle")?.addEventListener("click", () => {
				const dark = document.documentElement.classList.toggle("dark");
				localStorage.setItem("theme", dark ? "dark" : "light");
			});
		</script>
	</body>
</html>
